<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Games ship this on iOS NativeAOT with full trimming, so the analyzers check it the same way. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<!-- The runtime only: the compiler (ANTLR and friends) stays in the editor's importer. -->
		<PackageReference Include="YarnSpinner" Version="3.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WolfEngine\WolfEngine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WolfEngine.Dialogue.Tests" />
	</ItemGroup>

</Project>
